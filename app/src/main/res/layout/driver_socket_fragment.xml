<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- Back Button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/arrow_left_alt_24px"
            android:padding="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Live Panel"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#1A73E8"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Socket Status -->
    <TextView
        android:id="@+id/socketStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connecting to server…"
        android:textColor="#1A73E8"
        android:textSize="14sp" />

    <!-- Bus Info Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#EEF3FD"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:elevation="3dp">

        <TextView
            android:id="@+id/busNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bus: -"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000"/>

        <TextView
            android:id="@+id/routeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Route: -"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:textColor="#000"/>

        <TextView
            android:id="@+id/seatsRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remaining Seats: -"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            android:textColor="#1A73E8"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Live WebSocket Message -->
    <TextView
        android:id="@+id/liveMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Waiting for updates..."
        android:textSize="16sp"
        android:textColor="#000000"
        android:paddingTop="10dp" />

</LinearLayout>
