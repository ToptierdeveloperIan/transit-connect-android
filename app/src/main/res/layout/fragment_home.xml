<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Main Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Map -->
        <fragment
            android:id="@+id/mapView"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Hamburger Icon -->
        <ImageView
            android:id="@+id/hamburgerIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="16dp"
            android:layout_gravity="start|top"
            android:src="@drawable/settings"
            android:contentDescription="Menu Icon"
            android:elevation="8dp"
            app:tint="@color/blue_primary"/>

        <!-- Bottom Sheet -->
        <LinearLayout
            android:id="@+id/bottomsheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:padding="16dp"
            android:background="@drawable/rounded_grey_bar"
            android:elevation="12dp">

            <TextView
                android:id="@+id/whereto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/search_bar_bg"
                android:hint="Click the button below to start your Request"
                android:textColor="@color/black"
                android:textColorHint="@color/gray"
                android:drawablePadding="10dp"/>

            <TextView
                android:id="@+id/bookingStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@android:color/holo_green_dark"
                android:textSize="16sp"
                android:visibility="gone"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/trigger"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Request Ride"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/blue_primary"
                android:layout_marginTop="12dp"
                android:drawablePadding="8dp"/>
        </LinearLayout>

        <!-- Animation Overlay -->
        <FrameLayout
            android:id="@+id/animationoverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#80000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/topPanel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:gravity="center"
                    android:elevation="8dp">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Top Panel"
                        android:textSize="18sp"
                        android:textColor="@color/blue_primary"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bottomPanel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:gravity="center"
                    android:elevation="8dp">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Bottom Panel"
                        android:textSize="18sp"
                        android:textColor="@color/blue_primary"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        app:menu="@menu/nav_menu"
        app:itemIconTint="@color/blue_primary"
        app:itemTextColor="@color/blue_primary"/>
</androidx.drawerlayout.widget.DrawerLayout>
