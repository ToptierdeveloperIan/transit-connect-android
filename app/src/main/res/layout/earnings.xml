<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/quantum_ic_arrow_back_grey600_24"
                app:tint="@color/blue_light"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Earnings Dashboard"
                android:textColor="#1A73E8"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"/>
        </LinearLayout>

        <!-- Earnings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="20dp"
            android:elevation="4dp"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:clipToPadding="false"
            android:paddingBottom="25dp"
            android:backgroundTint="#FFFFFF"
            android:shape="rectangle"
            android:outlineProvider="background"
            android:background="@drawable/earning_card_bg">

            <TextView
                android:id="@+id/todayEarnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KES 0.00"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:paddingBottom="5dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Earnings"
                android:textColor="#555555"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <!-- Total Trips Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/earning_small_card"
                android:layout_marginEnd="10dp">

                <TextView
                    android:id="@+id/totalTrips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trips"
                    android:textSize="14sp"
                    android:textColor="#555555"/>

            </LinearLayout>

            <!-- Hours Online Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/earning_small_card"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/hoursOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0h"
                    android:textColor="#000000"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textSize="14sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Recent Trips Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recent Trips"
            android:textColor="#1A73E8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"
            android:paddingBottom="10dp"/>

        <!-- Trip List -->
        <LinearLayout
            android:id="@+id/recentTripsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Dynamically populated items -->
        </LinearLayout>

    </LinearLayout>
</ScrollView>
